# Copy to deploy/.env and fill in, then run:
#   docker compose --env-file deploy/.env up -d --build
#
# Long random value for Django signing (e.g. `python -c "import secrets; print(secrets.token_urlsafe(64))"`)
RCI_SECRET_KEY=change-me-to-a-long-random-string

# Public hostname(s) served through the Cloudflare tunnel (comma-separated, no scheme).
RCI_ALLOWED_HOSTS=rci.example.com

# https origin(s) allowed to POST to Django admin forms behind the tunnel.
RCI_CSRF_TRUSTED_ORIGINS=https://rci.example.com

# Google Identity Services client id (used by both the SPA build and the API).
# RCI_GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com

# Password for the bundled PostgreSQL container (only used with
# docker-compose.postgres.yml; use URL-safe characters).
RCI_DB_PASSWORD=change-me-strong-db-password

# Optional overrides
# Database selection: leave unset for the SQLite volume (default).
# Point at any PostgreSQL server to skip the bundled container:
# RCI_DATABASE_URL=postgresql://user:password@db-host:5432/rci
# RCI_SUPERADMIN_EMAIL=you@example.com
